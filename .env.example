# Environment Configuration Template
# Copy this file to .env.dev or .env.production and update the values

# API Configuration
# Development: http://127.0.0.1:4008
# Production: http://206.189.82.117:3003
REACT_APP_API_URL=http://206.189.82.117:3003

# Public URL (optional, for routing)
# Leave empty if not using a base path
PUBLIC_URL=

# Environment
# Options: development, production, test
NODE_ENV=development

# Enable/Disable features (optional)
REACT_APP_ENABLE_DEBUG=true
REACT_APP_ENABLE_LOGGING=true
