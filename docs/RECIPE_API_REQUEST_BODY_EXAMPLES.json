  "field_descriptions": {
    "root_level": {
      "name": "string (required) - Recipe name",
      "productId": "UUID (required for create) - Product/Item UUID",
      "itemId": "UUID (required for create) - Item UUID (same as productId)",
      "batchSize": "string (required for create) - Batch size identifier",
      "totalTime": "number (required) - Total process time in minutes",
      "status": "string (optional) - Recipe status: 'active', 'draft', 'archived'",
      "ingredients": "array (required) - Array of ingredient objects",
      "steps": "array (required) - Array of recipe step objects",
      "preparationQuestions": "array (optional) - Array of preparation step objects"
    },
    "step_object": {
      "order": "number (required) - Order in unified queue (1, 2, 3, ...)",
      "instruction": "string (required) - Step instruction text",
      "temperature": "number (optional) - Temperature in Celsius (can be null)",
      "duration": "number (required) - Duration in minutes"
    },
    "preparation_question_object": {
      "order": "number (required) - Order in unified queue (1, 2, 3, ...)",
      "questions": "array (required) - Array of question objects"
    },
    "question_object": {
      "question": "string (required, max 500 chars) - Question text",
      "hasCheckbox": "boolean (required) - Whether to display checkbox"
    },
    "ingredient_object": {
      "name": "string (required) - Ingredient name",
      "quantity": "number (required) - Quantity amount",
      "unit": "string (required) - Unit of measurement",
      "category": "string (optional) - Ingredient category"
    }
  },
  "important_notes": [
    "The 'order' field in both 'steps' and 'preparationQuestions' represents a unified queue",
    "Order values should be unique across both arrays",
    "Backend should preserve order values when storing and retrieving",
    "When displaying recipes, sort by 'order' regardless of type (step or preparation)",
    "Each preparation step can contain multiple questions",
    "Temperature can be null if not specified",
    "For updates, productId, itemId, and batchSize are not sent"
  ]
}
